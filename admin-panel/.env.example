VITE_API_BASE=http://localhost:4000
VITE_ADMIN_SECRET=your-admin-secret-key

body {
  @apply bg-gray-50;
}

html {
  scroll-behavior: smooth;
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  @apply bg-gray-100;
}

::-webkit-scrollbar-thumb {
  @apply bg-gray-300 rounded-full hover:bg-gray-400;
}
