# Supabase project URL
SUPABASE_URL=https://uybhscmvncjxsokzgyuu.supabase.co

# Backend privileged key (recommended for server-side writes/admin operations)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional fallback key for non-privileged backend reads/dev
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YrwUu2cBLSQH94FhKE7VWw_m01AKlK6

# Optional direct Postgres URL (for ORM/migrations/server SQL access)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.uybhscmvncjxsokzgyuu.supabase.co:5432/postgres

# Local backend port
BACKEND_PORT=4000

# CinetPay collection integration
CINETPAY_API_KEY=your_cinetpay_api_key_here
CINETPAY_SITE_ID=your_cinetpay_site_id_here
CINETPAY_SECRET_KEY=your_cinetpay_secret_key_here
CINETPAY_CURRENCY=XAF
CINETPAY_COUNTRY_CODE=CM
CINETPAY_DEFAULT_ADDRESS=Sungku
CINETPAY_DEFAULT_CITY=Douala
CINETPAY_DEFAULT_ZIP_CODE=00000

# CinetPay transfer API (client.cinetpay.com)
CINETPAY_TRANSFER_API_KEY=your_cinetpay_transfer_api_key_here
CINETPAY_TRANSFER_PASSWORD=your_cinetpay_transfer_password_here

# NotchPay transfer API
NOTCHPAY_PUBLIC_KEY=your_notchpay_public_key_here
NOTCHPAY_PRIVATE_KEY=your_notchpay_private_key_here
NOTCHPAY_HASH_KEY=your_notchpay_hash_key_here

# Public backend URL reachable by payment notify/return callbacks
BACKEND_PUBLIC_URL=https://your-public-backend-url.example.com

# ─── CamPay (paiement Mobile Money Cameroun) ───────────────────────────────
# https://campay.net — app.campay.net (production) / demo.campay.net (test)
# IMPORTANT : ne jamais exposer ces clés côté client ou dans le code source
CAMPAY_APP_ID=your_campay_app_id_here
CAMPAY_USERNAME=your_campay_username_here
CAMPAY_PASSWORD=your_campay_password_here
# Jeton d'accès permanent (optionnel — le backend peut aussi s'authentifier via username/password)
CAMPAY_ACCESS_TOKEN=your_campay_permanent_access_token_here
# Clé de signature des webhooks CamPay
CAMPAY_WEBHOOK_SECRET=your_campay_webhook_secret_here
# URL de base : demo.campay.net pour les tests, app.campay.net pour la production
CAMPAY_BASE_URL=https://demo.campay.net

# ─── Firebase (Auth custom tokens + FCM push notifications) ────────────────
# Projet : sungku-send  (Project number: 1056910886830)
#
# Pour obtenir FIREBASE_SERVICE_ACCOUNT_JSON :
#   1. Firebase Console → Project settings → Service accounts
#   2. Cliquer "Generate new private key" → télécharger le JSON
#   3. Encoder en base64 :
#      PowerShell : [Convert]::ToBase64String([IO.File]::ReadAllBytes("sa.json"))
#      Linux/Mac  : base64 -w 0 service-account.json
#   4. Coller la chaîne ci-dessous
FIREBASE_PROJECT_ID=sungku-send
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── SMS — Africa's Talking (recommandé pour le Cameroun) ─────────────────
# https://africastalking.com — Compte gratuit disponible en sandbox
# Username "sandbox" pour les tests, votre vrai username pour la production
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_africastalking_api_key_here
# Sender ID optionnel (alphanumérique, max 11 chars, validé par AT)
AFRICASTALKING_SENDER_ID=Sungku

# ─── SMS — Twilio (fallback) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
